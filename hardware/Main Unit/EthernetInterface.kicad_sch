		(uuid "c7e7ccdb-d17b-4c5f-bd90-19284a776212")
	)
	(text_box "This part number of PHY is set up for MCUs like ours that can output a 50MHz clock. This clock is input to the PHY on the XI pin and is used both for the Ethernet signal generation and for the RMII interface.\nLook ma, no dedicated Ethernet crystal needed!"
		(exclude_from_sim no)
		(at 44.45 106.68 0)
