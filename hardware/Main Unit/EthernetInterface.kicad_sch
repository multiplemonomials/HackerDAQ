				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6d006ed1-eaf0-46be-b04d-008ae667ffef")
	)
	(text_box "Per datasheet, RX_ER should be pulled low for correct operation (I guess it's an undocumented strapping pin?)"
		(exclude_from_sim no)
		(at 41.91 171.45 0)
		(size 30.48 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
