		(uuid "b6e37303-fd0f-4568-a00b-ac32d29ff544")
	)
	(text_box "Unfortunately there is only one LED pin on this PHY (it defaults to on for link up, flashing for activity). So, we will need to use the MCU to manually control the other (link speed) LED."
		(exclude_from_sim no)
		(at 246.38 77.47 0)
