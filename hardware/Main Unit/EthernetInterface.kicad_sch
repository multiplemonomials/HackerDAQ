		(uuid "84a59eea-9001-408a-ac75-1013273d5e47")
	)
	(text_box "Ferrite bead per KSZ8081 reference design"
		(exclude_from_sim no)
		(at 210.82 95.25 0)
		(size 17.78 10.16)
