		(uuid "a275f35a-86ea-4bba-af7f-12877fa6c1cb")
	)
	(text_box "CRS_DV pulled down to low and REF_CLK set high sets the PHY address to 4"
		(exclude_from_sim no)
		(at 44.45 149.86 0)
		(size 31.75 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
