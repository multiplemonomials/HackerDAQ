	(text "Current sense output:\nScaling Factor: 0.25V/A (8A = 2V)\nCutoff Frequency: 800Hz\nGain Error: about +-2% \n    (+-1% due to shunt resistor tolerance, \n    +-1% due to INA180 input filter)\nOffset Error: about +-25mA"
		(exclude_from_sim no)
		(at 240.284 126.746 0)
