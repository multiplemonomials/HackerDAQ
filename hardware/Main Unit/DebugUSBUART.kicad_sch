		(uuid "1df7ffa8-b99e-48a5-9ca2-4dd814ce8f0f")
	)
	(text_box "https://hackaday.com/2022/12/06/usb-c-introduction-for-hackers/"
		(exclude_from_sim no)
		(at 13.97 53.34 0)
		(size 72.39 3.81)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6f33dad3-b7ea-4bd7-a53b-9e2a78c67546")
	)
	(text_box "Datasheet gives maximum GPIO current as 25mA each, so shooting for 10mA LED current.\nFor the yellow LED, Vf @ 10mA is 1.95V, so a 140 ohm resistor will produce the needed voltage drop.\nFor the blue LED, Vf @ 10mA is 3.0V, so a 30 ohm resistor."
		(exclude_from_sim no)
		(at 181.61 91.44 0)
		(size 40.64 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "91635a8e-66c4-4462-824b-4b78dbd09a01")
	)
	(text_box "Note: WAKEUP pin is active high by default, so we ground it to disable the wakeup functionality."
		(exclude_from_sim no)
		(at 59.69 95.25 0)
		(size 41.91 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
