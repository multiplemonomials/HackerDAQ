			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a6add31c-99c3-446d-b6c8-0b6a5daf05f5")
	)
	(text_box "Using standard USB-C connector setup for data and 5V power. Shield not connected as it will be connected on the host side. See here for more details:"
