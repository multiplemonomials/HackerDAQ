	(text "This sheet implements a USB-C to UART converter using the Infineon (Cypress) \nCY7C65223 converter IC.\nThis chip is a favorite of mine because it is very simple to implement in\na design: it has an internal EEPROM for storing settings, and does clock\nrecovery from the USB signal so it doesn't need an external crystal. It can\nalso be flashed over USB with a custom serial number/name/description!"
		(exclude_from_sim no)
		(at 81.788 26.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "08babf93-17c8-4a9b-a775-67998ac3236d")
	)
	(text "USB to UART Converter"
		(exclude_from_sim no)
		(at 103.886 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "143764cf-7506-43d4-aa8c-2c354de9df04")
	)
	(text "Tx/Rx swap occurs here!"
		(exclude_from_sim no)
		(at 157.988 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "87403779-d46b-4105-8e95-21b73c3aa3ca")
	)
	(text_box "Datasheet says to ground all unused input pins.\nIgnoring ~{POWER} and SUSPEND because we aren't using suspend mode."
		(exclude_from_sim no)
		(at 118.11 102.87 0)
		(size 36.83 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
