	(text "Truth Table"
		(exclude_from_sim no)
		(at 124.46 110.49 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "083fd49e-9c41-4f60-bc76-0a004be9f8d7")
	)
	(text "This sheet implements the digital I/O driver for HackerDAQ. It is designed to power small DC loads such as relays, \nlights, and other electronics that need a DC input signal.\nIt implements the following features:\n- Adjustable logic high voltage (V_{LOGIC}) between 3.3V and 24V\n- High current drive capability (up to 4A, if the power supply is sufficient)\n- Optional 10k pullup or pulldown\n- Status LED that shows the logic level on the DIO line (regardless of I/O direction)\n- Very high impedance (should be >1MOhm) when pullups are disabled\n- 3x control lines for each channel at 5V logic level (would have preferred 3.3V,\n    but both the gate driver and comparator are 5V only...)"
		(exclude_from_sim no)
		(at 19.558 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "086e4a05-abd5-4568-9e2c-f12ac9524f86")
	)
	(text "Schmitt Trigger Comparator"
		(exclude_from_sim no)
		(at 184.912 189.484 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "3965f81e-0d7b-4fba-ac62-1e92096cff85")
	)
	(text "High-Current Logic Output"
		(exclude_from_sim no)
		(at 233.426 44.45 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "40ea2799-eb82-4802-9156-91bbee1f84df")
	)
	(text "HackerDAQ Digital I/O Driver"
		(exclude_from_sim no)
		(at 61.214 20.828 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "81ef7719-6342-4026-9fbb-1df4c06be333")
	)
